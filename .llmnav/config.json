  "audit": {
    "dispositions": [
      {
        "path": "src-tauri/src/project_repository_task_powershell_tests.rs",
        "reason": "Contains real PowerShell execution regressions only; script generation, record publication and output preview policy are owned by the task PowerShell module."
      },
      {
        "path": "src-tauri/src/project_repository_task_tests.rs",
        "reason": "Contains repository task regression tests and fixtures only; runtime launch, record publication and reconciliation are owned by the repository task module, and historical reads by the task history module."
      },
      {
        "path": "src/routes/briefs/+page.svelte",
        "reason": "Route composes the existing workspace gate, appearance subscription, and BriefsPanel; brief lifecycle and storage policy are owned by the brief registry and storage adapter."
      },
      {
        "path": "src/lib/i18n/workduck-message-contract.ts",
        "reason": "Compile-time mapped type widens locale literals only; it has no runtime validation or message-selection behavior."
      },
      {
        "path": "src/lib/projects/project-board-errors.ts",
        "reason": "Maps already-classified project errors to localized copy; error ownership remains in the source modules and locale catalogs."
      },
      {
        "path": "src/lib/queue/domain/queue-artifact-files.ts",
        "reason": "Thin filename composition delegates ID and slug rules and owns no independent artifact lifecycle or storage contract."
      },
      {
        "path": "src/lib/queue/queue-panel-types.ts",
        "reason": "Collects view-model types and fixed filter option IDs; it owns no queue filtering, execution, or persistence policy."
      },
      {
        "path": "src/routes/processes/+page.svelte",
        "reason": "Client fallback mirrors the legacy redirect only; process interface ownership remains on the root page."
      },
      {
        "path": "src/routes/processes/+page.ts",
        "reason": "Legacy route redirects immediately to the root page and owns no process workflow."
      },
      {
        "path": "src-tauri/src/cli/agent_evaluation/tests.rs",
        "reason": "Contains CLI evaluation regression tests and fixtures only; runtime evaluation admission, aggregation and persistence are owned by the parent evaluation module."
      }
    ]
  },
