{
  "name": "workduck",
  "version": "1.6.119",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "bin": {
    "workduck": "scripts/workduck.mjs",
    "workduck-mcp": "scripts/workduck-mcp.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev --host 127.0.0.1 --port 5173 --strictPort",
    "dev:tauri": "bun ./scripts/tauri-dev-server.mjs",
    "build": "vite build && bun ./scripts/apply-csp-to-build.mjs",
    "desktop:dev": "tauri dev",
    "desktop:preview": "bun run build && tauri dev --no-watch --config src-tauri/tauri.preview.conf.json",
    "desktop:build": "tauri build",
    "workduck": "bun ./scripts/workduck.mjs",
    "mcp": "bun ./scripts/workduck-mcp.mjs",
    "preview": "vite preview",
    "prepare": "bun ./scripts/prepare-workduck.mjs",
    "sync:ssealed-scaffold": "bun ./scripts/sync-ssealed-scaffold.mjs --write",
    "check:ssealed-scaffold": "bun ./scripts/sync-ssealed-scaffold.mjs --check",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json && bun run check:packages && bun run check:ssealed-scaffold",
    "check:packages": "tsgo -p packages/core/tsconfig.json --noEmit && tsgo -p packages/schemas/tsconfig.json --noEmit && tsgo -p packages/prompts/tsconfig.json --noEmit && tsgo -p packages/agents/tsconfig.json --noEmit && tsgo -p packages/workbench-engine/tsconfig.json --noEmit",
    "check:packages:tsc": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/schemas/tsconfig.json --noEmit && tsc -p packages/prompts/tsconfig.json --noEmit && tsc -p packages/agents/tsconfig.json --noEmit && tsc -p packages/workbench-engine/tsconfig.json --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "llmnav:audit": "llmnav audit --fail-on high",
    "llmnav:check": "llmnav check",
    "llmnav:format": "llmnav format --check",
    "llmnav:generate": "llmnav generate",
    "llmnav:eval": "llmnav eval",
    "verify": "bun run check && bun run test && bun run build && bun run test:rust",
    "test:environment": "bun test src/lib/environment/cli-environment-variables.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/node": "^26.4.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bits-ui": "^2.19.0",
    "llmnav": "^0.9.0",
    "pretendard": "^1.3.9",
    "ssealed": "^0.6.12",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tauri-apps/plugin-notification": "~2.3.3"
  }
}
