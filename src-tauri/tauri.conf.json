{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Workduck",
  "version": "../package.json",
  "identifier": "com.workduck.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:tauri",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Workduck",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NEFGRTZCQTkzREUzNDEKUldSQjR6MnBhLzVLTkdaZUdZVjJHS2xodkR6WDR5RXU1MU53dFNtNzNwKzVReGdqS0lyaHBwUGYK",
      "endpoints": [
        "https://github.com/0disoft/workduck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
