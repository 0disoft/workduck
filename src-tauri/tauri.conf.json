{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Workduck",
  "version": "../package.json",
  "identifier": "com.workduck.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:tauri",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Workduck",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
